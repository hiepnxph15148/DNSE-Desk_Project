# API Key và API Secret lấy tại Entrade X → Thông tin cá nhân → LightSpeed API.
# API Secret chỉ hiện một lần. Không commit file này sau khi đã điền secret.
DNSE_API_KEY=
DNSE_API_SECRET=
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_API_VERSION=2026-07-23
DNSE_MARKET_TYPE=STOCK

# Đăng nhập Google (Google Cloud Console → OAuth 2.0 Client ID, loại Web).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WebSocket giá (cùng process `next dev`, không EventSource). Mặc định 3003.
# NEXT_PUBLIC_MARKET_WS_PORT=3003
# MARKET_WS_PORT=3003
